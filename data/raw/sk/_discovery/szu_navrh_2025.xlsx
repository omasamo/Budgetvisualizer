{
	var numberIcon = L.divIcon({ className: "number-icon", iconSize: [25, 41], iconAnchor: [10, 44], popupAnchor: [3, -40],  html: element[0] });
	
	L.marker([element[1], element[2]], { icon: numberIcon}).addTo(map).bindPopup(element[3]);
});
*/

var markers = L.markerClusterGroup({ chunkedLoading: true });
		
location_list.forEach(element => 
{
	var marker = L.marker(L.latLng(element[1], element[2]), { title: element[0] });
	marker.bindPopup(element[3]);
	markers.addLayer(marker);
});

map.addLayer(markers);
		
		

</script>





