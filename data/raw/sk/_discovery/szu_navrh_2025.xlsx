<!-- about_opendata section -->

<section id="about_opendata" class="govuk-body">
	<div class="container">
        <div class="row">	
		
			<div class="col-xs-12 col-md-6 col-lg-6">
				<p class="title">ČO SÚ OTVORENÉ DÁTA ?</p>
				<p class="desc">Otvorené dáta sú informácie alebo údaje voľne a bezplatne dostupné pre každého za rovnakých podmienok, ktoré je možné použiť na akýkoľvek účel komerčného či nekomerčného charakteru. Sú sprístupnené na internete v štruktúrovanej forme, ktorá umožňuje ich hromadné strojové spracovanie. Portál „www.opendata.mfsr.sk“ slúži na podporu otvorených finančných dát Slovenskej republiky a zvyšujú transparentnosť v zapojených inštitúciách.</p>								
				<div class="row">					
					<a href="/mi/page/odata"><div class="col-md-3 col-xs-4 button">Zobraziť viac</div></a>
				</div>		  				
			</div>		  
			<div class="col-xs-12 col-md-6 col-lg-6">
				<p class="title">AKÉ SÚ PRÍNOSY ?</p>
				<p class="desc">Kvalitné a odborne spracovávané dáta umožňujú štátu robiť informovanejšie a efektívnejšie rozhodnutia, vyhodnocovať svoje aktivity, rýchlejšie a adresnejšie reagovať na potreby svojich obyvateľov, čo vo výsledku môže znamenať úsporu verejných financií pri zvyšovaní kvality života. Dáta predstavujú pre obyvateľov štátu zdroj informácií o výkone ekonomiky, vďaka čomu môžu vyvodzovať potrebnú zodpovednosť voči ich voleným zástupcom. Pre podnikateľský a mimovládny sektor môžu dáta predstavovať prostriedok skvalitňovania poskytovaných služieb. A v neposlednom rade dáta stransparentňujú a zefektívňujú riadenie vecí verejných.</p>				
				<div class="row">					
			<!-- 	<a n:href="Page:odata"><div class="col-md-3 col-xs-4 button">Zobraziť viac</div></a> -->
				</div>		  				
			</div>	
			
		</div>
	</div>
</section> 

<!-- end of about_opendata section -->






<!-- tatra section -->

<section id="tatra" class="govuk-body">
	<div class="container">
	
			<div class="row tatra-bg" id="intros_slider">
			  <div class="col-xs-12 col-sm-6 col-md-4">
				<div class="row">			  
				<div class="col-xs-12 square">
			  
					<p><img style="max-height:100px;" src="/img/intros/10_mi.jpg" class="active" alt=""></p>
					<p><img style="max-height:30px; padding:0px;" src="/img/square_line.png" class="active" alt=""></p>
					<p class="title">Sekcia štátneho výkazníctva</p>	
					<span class="desc truncate"><p>Sekcia &scaron;t&aacute;tneho v&yacute;kazn&iacute;ctva je zodpovedn&aacute; za zber a&nbsp;spracovanie &uacute;dajov potrebn&yacute;ch pre hodnotenie plnenia rozpočtu a&nbsp;&uacute;dajov z&nbsp;&uacute;čtovn&iacute;ctva d&ocirc;ležit&yacute;ch pre zostavenie n&aacute;rodnej a&nbsp;medzin&aacute;rodnej finančnej &scaron;tatistiky verejn&eacute;ho sektora. Pracuje približne s&nbsp;8000 &uacute;čtovn&yacute;mi jednotkami verejnej spr&aacute;vy, je biznis vlastn&iacute;kom viacer&yacute;ch nadrezortn&yacute;ch informačn&yacute;ch syst&eacute;mov (Centr&aacute;lny ekonomick&yacute; syst&eacute;m, Centr&aacute;lny konsolidačn&yacute; syst&eacute;m) alebo ich čast&iacute; (Register &uacute;čtovn&yacute;ch z&aacute;vierok, Syst&eacute;m &Scaron;t&aacute;tnej pokladnice, RISSAM.v&yacute;kazy), rozv&iacute;ja ,,&uacute;čtovn&eacute; &scaron;tandardy" pre&nbsp; &scaron;t&aacute;tne organiz&aacute;cie a&nbsp;organiz&aacute;cie &uacute;zemnej samospr&aacute;vy a&nbsp;usmerňuje ich v&nbsp;oblasti akru&aacute;lneho &uacute;čtovn&iacute;ctva a&nbsp;finančn&eacute;ho reportingu.</p></span>								
					<p>								

						<a href="/opendata/category/208--sekcia-statneho-vykaznictva" title="Odkaz sa otvorí v novom okne">
							<div tabindex="1"> Prezrieť</div>
						</a>	
					</p>
				</div>					
				</div>				
			  </div>
			  <div class="col-xs-12 col-sm-6 col-md-4">
				<div class="row">			  
				<div class="col-xs-12 square">
			  
					<p><img style="max-height:100px;" src="/img/intros/9_mi.jpg" class="active" alt=""></p>
					<p><img style="max-height:30px; padding:0px;" src="/img/square_line.png" class="active" alt=""></p>
					<p class="title">Inštitút finančnej politiky</p>	
					<span class="desc truncate"><p>In&scaron;tit&uacute;t finančnej politiky je analytick&yacute;m &uacute;tvarom ministerstva financi&iacute;, ktor&yacute; patr&iacute; medzi top analytick&eacute; jednotky na Slovensku a&nbsp;je jedn&yacute;m z&nbsp;najstar&scaron;&iacute;ch ekonomick&yacute;ch think-tankov verejnej spr&aacute;vy u&nbsp;n&aacute;s.</p></span>								
					<p>								

						<a href="/opendata/category/177--institut-financnej-politiky" title="Odkaz sa otvorí v novom okne">
							<div tabindex="1"> Prezrieť</div>
						</a>	
					</p>
				</div>					
				</div>				
			  </div>
			  <div class="col-xs-12 col-sm-6 col-md-4">
				<div class="row">			  
				<div class="col-xs-12 square">
			  
					<p><img style="max-height:100px;" src="/img/intros/1_mi.jpg" class="active" alt=""></p>
					<p><img style="max-height:30px; padding:0px;" src="/img/square_line.png" class="active" alt=""></p>
					<p class="title">Útvar hodnoty za peniaze</p>	
					<span class="desc truncate"><p>&Uacute;lohou &Uacute;HP Ministerstva financi&iacute; SR je zvy&scaron;ovať hodnotu, ktor&uacute; za svoje peniaze verejnosť dost&aacute;va. Na&scaron;im cieľom je posilniť orient&aacute;ciu na v&yacute;sledky pri rozhodovan&iacute; o&nbsp;verejn&yacute;ch politik&aacute;ch, regul&aacute;ci&aacute;ch, invest&iacute;ci&aacute;ch a&nbsp;prev&aacute;dzke &scaron;t&aacute;tu. Podstatou hodnoty za peniaze je pos&uacute;diť, či peniaze daňovn&iacute;kov bud&uacute; skutočne vynaložen&eacute; najlep&scaron;ie ako je možn&eacute; pre dosiahnutie stanoven&eacute;ho cieľa.</p></span>								
					<p>								

						<a href="/opendata/category/178--utvar-hodnoty-za-peniaze" title="Odkaz sa otvorí v novom okne">
							<div tabindex="1"> Prezrieť</div>
						</a>	
					</p>
				</div>					
				</div>				
			  </div>
			  <div class="col-xs-12 col-sm-6 col-md-4">
				<div class="row">			  
				<div class="col-xs-12 square">
			  
					<p><img style="max-height:100px;" src="/img/intros/2_mi.jpg" class="active" alt=""></p>
					<p><img style="max-height:30px; padding:0px;" src="/img/square_line.png" class="active" alt=""></p>
					<p class="title">Štátna pokladnica</p>	
					<span class="desc truncate"><p>&Scaron;t&aacute;tna pokladnica je s&uacute;časťou komplexn&eacute;ho finančn&eacute;ho manažmentu verejn&yacute;ch financi&iacute; Slovenskej republiky a<span style="mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin; mso-bidi-font-weight: bold;"> m&aacute; celo&scaron;t&aacute;tny v&yacute;znam aj vplyv. Vystupuje ako spoľahliv&yacute; partner &scaron;t&aacute;tu a&nbsp;m&aacute; d&ocirc;veru &scaron;t&aacute;tnych in&scaron;tit&uacute;ci&iacute; a&nbsp;obyvateľstva. </span>Je bezpečn&yacute;m poskytovateľom a&nbsp;spoľahliv&yacute;m garantom platobn&yacute;ch služieb z<span style="font-family: Calibri, sans-serif;">abezpečuj&uacute;cim realiz&aacute;ciu rozpočtu klientov &scaron;t&aacute;tneho a&nbsp;verejn&eacute;ho sektora. </span>&Scaron;t&aacute;tna pokladnica raz&iacute; cestu bezpečn&eacute;ho a&nbsp;inovat&iacute;vneho pr&iacute;stupu s&nbsp;cieľom digitalizovať v&nbsp;čo najv&auml;č&scaron;ej miere svoje služby. Refinančn&yacute; syst&eacute;m vybudovan&yacute; medzi &Scaron;P a&nbsp;ARDAL je unik&aacute;tny aj v&nbsp;eur&oacute;pskom meradle a&nbsp;v&yacute;znamnou mierou prispieva k&nbsp;&uacute;spor&aacute;m dosiahnut&yacute;ch pri spr&aacute;ve &scaron;t&aacute;tneho dlhu.</p></span>								
					<p>								

						<a href="/opendata/category/193--statna-pokladnica" title="Odkaz sa otvorí v novom okne">
							<div tabindex="1"> Prezrieť</div>
						</a>	
					</p>
				</div>					
				</div>				
			  </div>
			  <div class="col-xs-12 col-sm-6 col-md-4">
				<div class="row">			  
				<div class="col-xs-12 square">
			  
					<p><img style="max-height:100px;" src="/img/intros/3_mi.jpg" class="active" alt=""></p>
					<p><img style="max-height:30px; padding:0px;" src="/img/square_line.png" class="active" alt=""></p>
					<p class="title">EXIMBANKA</p>	
					<span class="desc truncate"><p>EXIMBANKA SR je ako jedin&yacute; priamy n&aacute;stroj &scaron;t&aacute;tu na financovanie exportu d&ocirc;ležitou s&uacute;časťou reťazca zodpovedn&eacute;ho za presadzovanie hospod&aacute;rskej politiky krajiny v&nbsp;oblasti vonkaj&scaron;&iacute;ch ekonomick&yacute;ch vzťahov. Predstavuje d&ocirc;ležit&yacute; n&aacute;stroj &scaron;t&aacute;tnej podpory exportu v&nbsp;oblasti financovania &uacute;verov&yacute;ch produktov, poskytovania z&aacute;ruk a&nbsp;poistenia &uacute;verov&yacute;ch riz&iacute;k. Ako &scaron;t&aacute;tna exportno-&uacute;verov&aacute; agent&uacute;ra umožňuje vstup slovensk&yacute;m export&eacute;rom do obchodn&yacute;ch a&nbsp;investičn&yacute;ch vzťahov, kde komerčn&yacute; finančn&yacute; sektor prejavuje men&scaron;&iacute; z&aacute;ujem prevziať na seba riziko a&nbsp;pln&iacute; preto komplement&aacute;rnu funkciu.</p></span>								
					<p>								

						<a href="/opendata/category/198--exim-banka" title="Odkaz sa otvorí v novom okne">
							<div tabindex="1"> Prezrieť</div>
						</a>	
					</p>
				</div>					
				</div>				
			  </div>
			  <div class="col-xs-12 col-sm-6 col-md-4">
				<div class="row">			  
				<div class="col-xs-12 square">
			  
					<p><img style="max-height:100px;" src="/img/intros/4_mi.jpg" class="active" alt=""></p>
					<p><img style="max-height:30px; padding:0px;" src="/img/square_line.png" class="active" alt=""></p>
					<p class="title">Finančná správa</p>	
					<span class="desc truncate"><p>Finančn&aacute; spr&aacute;va je org&aacute;nom &scaron;t&aacute;tnej spr&aacute;vy v&nbsp;oblasti dan&iacute;, poplatkov a&nbsp;cla. Tvoria ju Finančn&eacute; riaditeľstvo SR, coln&eacute; &uacute;rady, daňov&eacute; &uacute;rady a&nbsp;Krimin&aacute;lny &uacute;rad finančnej spr&aacute;vy. &Uacute;lohou finančnej spr&aacute;vy je v&yacute;ber dan&iacute; a&nbsp;cla s&nbsp;cieľom zabezpečiť pr&iacute;jmy do &scaron;t&aacute;tneho rozpočtu Slovenskej republiky a&nbsp;Eur&oacute;pskej &uacute;nie, ochrana ekonomick&yacute;ch z&aacute;ujmov &scaron;t&aacute;tu a&nbsp;ochrana v&yacute;davkovej časti &scaron;t&aacute;tneho rozpočtu SR. Finančn&aacute; spr&aacute;va je proklientskou in&scaron;tit&uacute;ciou. Neust&aacute;le pracuje na moderniz&aacute;cii a&nbsp;elektroniz&aacute;cii procesov s&nbsp;cieľom zv&yacute;&scaron;iť kvalitu poskytovan&yacute;ch služieb občanom aj podnikateľom.</p></span>								
					<p>								

						<a href="/opendata/category/208--sekcia-statneho-vykaznictva" title="Odkaz sa otvorí v novom okne">
							<div tabindex="1"> Prezrieť</div>
						</a>	
					</p>
				</div>					
				</div>				
			  </div>
			  
